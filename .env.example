# Dexter v2 - local development environment (DEV ONLY - never reuse these values anywhere real).
# cp .env.example .env
# Values must be shell-safe (they are also `source`d by scripts/run.sh).

COMPOSE_PROJECT_NAME=dexter

# --- Postgres superuser (container init only; services never use it) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_super_change_me
POSTGRES_PORT=5432

# Databases + roles rendered by infra/postgres/render-roles.sh (MASTER_PLAN 3.1).
DEXTER_DB_SERVICES="identity ledger catalog portfolio planning reco billing commerce audit"

# One password per role kind. Override per service with PG_PW_<SERVICE>_<ROLE>,
# e.g. PG_PW_LEDGER_APP=something_else
PG_PW_OWNER=dev_owner_pw
PG_PW_APP=dev_app_pw
PG_PW_ADMIN=dev_admin_pw
PG_PW_RELAY=dev_relay_pw
PG_PW_READONLY=dev_readonly_pw

# --- Redis ---
REDIS_PASSWORD=dev_redis_pw
REDIS_PORT=6379
# Per-service ACL users (infra/redis/acl.tmpl, ADR-0004 §8). Override per service with REDIS_PW_<SERVICE>.
DEXTER_REDIS_USERS="gateway identity ledger catalog portfolio planning reco billing commerce audit"
REDIS_PW_SERVICE=dev_redis_svc_pw

# --- Kafka (KRaft) ---
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# --- Object store (SeaweedFS S3 gateway, ADR-0003). P12: S3 identities rendered from the keys below (ADR-0017). ---
OBJECTSTORE_PORT=8333
# Every request is signed with these (presigned URLs too); anonymous requests are refused.
OBJECTSTORE_ACCESS_KEY=dexter-dev
OBJECTSTORE_SECRET_KEY=dexter-dev-objectstore-secret
OBJECTSTORE_PUBLIC_URL=http://localhost:8333
# P10: catalog ingestion may fetch this local mock issuer site (api-smoke serves it) over http on a private address.
# Dev only: production leaves CATALOG_INGEST_DEV_HOSTS empty (allowlisted https issuer hosts on public addresses).
CATALOG_INGEST_DEV_HOSTS=127.0.0.1:18091
CATALOG_INGEST_POLITENESS=200ms

# --- Grafana ---
# P19 (ADR-0026): Vault (compose core profile); run.sh core initialises it (keys in .run/vault, dev only).
VAULT_PORT=8200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_grafana_pw

# --- Service ports (read by application.yml as PORT_<SERVICE>) ---
PORT_GATEWAY=8080
PORT_IDENTITY=8081
PORT_LEDGER=8082
PORT_CATALOG=8083
PORT_PORTFOLIO=8084
PORT_AI_PARSER=8090
PORT_PLANNING=8085
PORT_RECO=8086
PORT_BILLING=8087
PORT_COMMERCE=8088
PORT_AUDIT=8089

# --- Demo accounts (seed generator, P03: ./scripts/seed.sh small|medium|large) ---
# asha@demo.in, ravi@demo.in (identity.accounts) and admin@demo.in (identity.admins).
DEMO_PASSWORD_ASHA=Asha-Demo-2026!
DEMO_PASSWORD_RAVI=Ravi-Demo-2026!
DEMO_PASSWORD_ADMIN=Admin-Demo-2026!
# Shared password of every bulk seed account (u0000001@seed.test ...). Hashed once (Argon2id), ADR-0008.
SEED_BULK_PASSWORD=Seed-Bulk-2026!

# --- Identity (P04). DEV ONLY random values; production reads them from Vault (P19). ---
# Key-encryption key for per-account data keys and JWT signing keys: base64 of 32 random bytes.
IDENTITY_KEK_K1=xWvKCQwQCCJ34PpXfxkuXQHJWsfgH+GS3+C/aVmmvXQ=
# HMAC pepper for the phone-number blind index: base64 of >= 32 random bytes.
IDENTITY_PHONE_PEPPER=8ovGDsxSlhTVa+j2a1SqjevYtkc88OZqjfJT5MNzxb4=
# Keyset-cursor HMAC key (MASTER_PLAN 4.2): base64 of >= 32 random bytes.
LEDGER_CURSOR_KEY_C1=I7riDz9r+z3bim6e3B68qSChWRyfuAW9jeLr/F36MHM=
CATALOG_CURSOR_KEY_C1=p3QbSriZlsKmLmJnGg/ydPdHL5GeaxkN5Nl0yPSaA8U=
PORTFOLIO_CURSOR_KEY_C1=vwr+4qGSmxAUPk5KdeIcZ4Y3HJK+3mDtAIHouZXLZSw=
PLANNING_CURSOR_KEY_C1=vRl2axptfSxifJoqXvBYFs00qpKnKdtwEVtGZi6E0EE=
IDENTITY_CURSOR_KEY_C1=j1v3GylQDiIvwnDitBXCBi/XbChm8aGHwdd8NTUw49Q=
BILLING_CURSOR_KEY_C1=TKJ89wmJC7qEr3fi/2zODG3fIxWQEwgs7j4ekgFb/g4=
# P16: the mock payment provider signs its webhooks with this (HMAC-SHA256, >= 16 chars; dev only).
BILLING_MOCK_WEBHOOK_SECRET=KNEdgO9eyq4nR71RrmGav8wJCS-Wprd9_LSeJH4ppzo
COMMERCE_CURSOR_KEY_C1=4HxrfOFbTooXGzZj8XtET4DbrH+IbfBA+AV7w0OcVIA=
# P17: HMAC key of the signed /r/{token} redirect links (base64 of 32 random bytes; dev only).
COMMERCE_CLICK_TOKEN_KEY=BaQRmFS1fGW4Wr5qd+sWFxmKmmNUnbgdN2+5sH8ypeU=
# P17: salt of the ip / user-agent / visitor hashes behind uniques and frequency caps (>= 16 chars; dev only).
COMMERCE_HASH_SALT=QNNT-W1KCno8BnfR0NtAVN9nlKQDKDmr
# P17: the mock affiliate network signs its postbacks with this (HMAC-SHA256, >= 16 chars; dev only).
COMMERCE_AFFILIATE_SECRET_MOCK=Fl5__f7mnFCc3M6Gp6CScLWd22_a8LaMm9Q3oJbhydk
AUDIT_CURSOR_KEY_C1=hzJxom+JpMPhYQDxhqLYiPXrpogaCk5WRPL9KH/4/GE=
# P18: HMAC key of the pseudonym a completed deletion leaves in the audit service (base64 of 32 bytes; dev only).
AUDIT_SUBJECT_KEY=wtLzxfQLgW4vPwp1bBbyT/tVNGbN/sBRGbmTMSAXhGY=
# P18 dev pacing: the mock email/push transport refuses each notification's first attempt (the retry runs on every
# stack), retries start at 2 s, a privacy phase is re-asked after 20 s, and the audit chain is anchored every minute.
AUDIT_MOCK_FAIL_FIRST=1
AUDIT_NOTIFY_BACKOFF_BASE=2s
AUDIT_PRIVACY_PHASE_TIMEOUT=20s
AUDIT_ANCHOR_EVERY=1m
# Client-credentials secret every service uses in dev (override per service: SERVICE_CLIENT_SECRET_<SERVICE>).
SERVICE_CLIENT_SECRET=gLYpKpbqNGPCRCH0-QaminBmPMJJnlTZ
# Where email links point (the trail page in dev).
IDENTITY_PUBLIC_URL=http://localhost:8099
