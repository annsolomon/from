<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>dexter-identity</artifactId>
  <packaging>jar</packaging>
  <name>dexter-identity</name>
  <description>Accounts, credentials, sessions, refresh tokens, MFA, JWKS, admins, RBAC</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- P01: request id + MDC, ProblemDetail codes, strict JSON, PII-masked logs, dev-only /_dev/p01 lab -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-web</artifactId>
    </dependency>
    <!-- P04: the platform libraries (TenantTx/keyset, Idempotency-Key, outbox + relay, JWT verification) -->
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-db</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-idempotency</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-events</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-security</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-contracts</artifactId></dependency>
    <dependency>
      <!-- DataSource (Hikari) + JdbcClient. No JPA (MASTER_PLAN 3, enforcer bans it). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway runs as identity_owner (spring.flyway.user); the app pool connects as identity_app -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <!-- Argon2id password hashing (MASTER_PLAN 7.1); needs BouncyCastle (pinned in platform-bom, A-25) -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <!-- P05: login throttles and MFA challenges (Redis, per-service ACL user `identity`) -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <!-- verification / reset emails (Mailpit in dev) -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P04 (A-26): identity uses the full test kit (Testcontainers PG, RlsProofKit, IdempotencyContract,
           PaginationContract, ArchRules), so dexter-test is declared without the P03 exclusion. -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
