<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>dexter-audit</artifactId>
  <packaging>jar</packaging>
  <name>dexter-audit</name>
  <description>Hash-chained audit log, activity analytics, notifications, privacy saga</description>

  <dependencies>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-observability</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- P01: request id + MDC, ProblemDetail codes, strict JSON, PII-masked logs, dev-only /_dev/p01 lab -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-web</artifactId>
    </dependency>
    <!-- P18: the platform libraries (TenantTx/keyset, Idempotency-Key, outbox + relay + consumers, JWT, object store) -->
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-db</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-idempotency</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-events</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-security</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-objectstore</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-contracts</artifactId></dependency>
    <dependency>
      <!-- DataSource (Hikari) + JdbcClient. No JPA (MASTER_PLAN 3, enforcer bans it). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway runs as audit_owner (spring.flyway.user); the app pool connects as audit_app -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P18 (A-26): the full test kit (Testcontainers PG/Kafka, RlsProofKit, IdempotencyContract,
           PaginationContract, ArchRules, TestJwt), declared without the P03 exclusion. -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P18: the multi-service saga test runs every participant's library code against its own migrated database -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-privacy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
