<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>dexter-gateway</artifactId>
  <packaging>jar</packaging>
  <name>dexter-gateway</name>
  <description>Edge: routing, JWT pre-check, rate limit, request-id, header hygiene</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <!-- P06: circuit breaker per route (Resilience4j, reactive) -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>
    <!-- P06: token-bucket rate limiter (Redis, ACL user `gateway`) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>
    <!-- P06: JWT pre-validation with the same verifier every service uses. dexter-web is servlet-only: excluded
         (the gateway uses only dexter-security's jwt package; its servlet auto-config is conditional on SERVLET). -->
    <dependency>
      <groupId>in.dexter</groupId>
      <artifactId>dexter-security</artifactId>
      <exclusions>
        <exclusion><groupId>in.dexter</groupId><artifactId>dexter-web</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-core</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-contracts</artifactId></dependency>
    <!-- P06: activity events (plain producer, no outbox: the gateway has no database) -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P03 (A-22, A-26): ArchitectureTest. Only ArchRules + ArchUnit on the test classpath; everything else that
           dexter-test drags in (Testcontainers, Kafka, Redis, servlet) is excluded so it cannot change the Spring
           test context. -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- P06 tests: WireMock backends (standalone = shaded, no Jetty/Jackson clash), Redis + Kafka containers -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
