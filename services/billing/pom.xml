<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>dexter-billing</artifactId>
  <packaging>jar</packaging>
  <name>dexter-billing</name>
  <description>Plans, subscriptions, entitlements, payments adapter, invoices, webhooks</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- P01: request id + MDC, ProblemDetail codes, strict JSON, PII-masked logs, dev-only /_dev/p01 lab -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-web</artifactId>
    </dependency>
    <!-- P16: the platform libraries (TenantTx/keyset, Idempotency-Key Mode B, outbox + relay, JWT, cache) -->
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-db</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-idempotency</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-events</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-security</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-contracts</artifactId></dependency>
    <!-- P16: GET /v1/entitlements/me cached 60 s per account (dexter-cache on the per-service ACL user `billing`) -->
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-cache</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- P16: Gst.on - the one definition of 18 % GST and its rounding (A-74/A-82: one answer to one question) -->
    <dependency><groupId>in.dexter</groupId><artifactId>portfolio-calc</artifactId></dependency>
    <dependency>
      <!-- DataSource (Hikari) + JdbcClient. No JPA (MASTER_PLAN 3, enforcer bans it). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway runs as billing_owner (spring.flyway.user); the app pool connects as billing_app -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P16 (A-26): the full test kit (Testcontainers PG/Redis, RlsProofKit, IdempotencyContract,
           PaginationContract, ArchRules, TestJwt), declared without the P03 exclusion. -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
