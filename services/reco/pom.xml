<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>dexter-reco</artifactId>
  <packaging>jar</packaging>
  <name>dexter-reco</name>
  <description>Spend profile, catalog projection, scoring, wallet optimizer, best-card, SSE</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- P01: request id + MDC, ProblemDetail codes, strict JSON, PII-masked logs, dev-only /_dev/p01 lab -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <!-- P14 (A-82): the shared reward arithmetic - RewardTerms.earn is the one definition of what a rule earns,
           so reco's rupees and portfolio's agree for the same card. Also EmiMath, as planning uses it (A-74). -->
      <groupId>in.dexter</groupId>
      <artifactId>portfolio-calc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-db</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-idempotency</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-events</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-security</artifactId></dependency>
    <dependency><groupId>in.dexter</groupId><artifactId>dexter-contracts</artifactId></dependency>
    <dependency>
      <!-- DataSource (Hikari) + JdbcClient. No JPA (MASTER_PLAN 3, enforcer bans it). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway runs as reco_owner (spring.flyway.user); the app pool connects as reco_app -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- P14: the full test kit now that reco has ITs - Testcontainers, the RLS/pagination/idempotency contracts
           and ArchRules. (P00-P13 excluded everything here because reco had only an ArchitectureTest.) -->
      <groupId>in.dexter</groupId>
      <artifactId>dexter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
