{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexter.in/events/portfolio.link.confirmed.v1.json",
  "title": "portfolio.link.confirmed v1 - an expense and a card transaction confirmed as one purchase (topic dexter.portfolio.link.v1, key = account id).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "linkId",
    "expenseId",
    "transactionId",
    "userCardId",
    "method",
    "confirmedAt"
  ],
  "properties": {
    "linkId": {
      "type": "string",
      "format": "uuid"
    },
    "expenseId": {
      "type": "string",
      "format": "uuid"
    },
    "transactionId": {
      "type": "string",
      "format": "uuid"
    },
    "userCardId": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
