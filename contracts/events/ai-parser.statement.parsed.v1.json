{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexter.in/events/ai-parser.statement.parsed.v1.json",
  "title": "ai-parser.statement.parsed v1 - the parser's result for one submitted statement (topic dexter.ai-parser.statement.v1, key = account id).",
  "description": "Produced by the Python ai-parser. Card numbers are redacted before parsing (redactions = how many); descriptions never carry a full PAN. status failed carries errorCode and no lines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uploadId",
    "userCardId",
    "status",
    "errorCode",
    "errorDetail",
    "parserVersion",
    "format",
    "issuer",
    "last4",
    "periodStart",
    "periodEnd",
    "dueDate",
    "totalDuePaise",
    "minDuePaise",
    "redactions",
    "lines",
    "parsedAt"
  ],
  "properties": {
    "uploadId": {
      "type": "string",
      "format": "uuid"
    },
    "userCardId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "parsed",
        "failed"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "errorDetail": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "parserVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "format": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "last4": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}$"
    },
    "periodStart": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "periodEnd": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dueDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "totalDuePaise": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "minDuePaise": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "redactions": {
      "type": "integer",
      "minimum": 0
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineNo",
          "postedOn",
          "description",
          "amountPaise",
          "direction",
          "kind"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "minimum": 1
          },
          "postedOn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "amountPaise": {
            "type": "integer",
            "minimum": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "purchase",
              "refund",
              "payment",
              "fee",
              "interest",
              "cashback",
              "emi"
            ]
          }
        }
      }
    },
    "parsedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
