<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.dexter</groupId>
    <artifactId>dexter-platform-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>platform-bom/pom.xml</relativePath>
  </parent>

  <artifactId>dexter-v2-parent</artifactId>
  <packaging>pom</packaging>
  <name>dexter-v2-parent</name>
  <description>Dexter v2 - Indian credit card intelligence and personal finance backend</description>

  <modules>
    <module>platform-bom</module>
    <module>libs/dexter-core</module>
    <module>libs/dexter-db</module>
    <module>libs/dexter-web</module>
    <module>libs/dexter-idempotency</module>
    <module>libs/dexter-events</module>
    <module>libs/dexter-cache</module>
    <module>libs/dexter-security</module>
    <module>contracts</module>
    <module>libs/dexter-test</module>
    <module>libs/dexter-lab</module>
    <module>libs/portfolio-calc</module>
    <module>services/gateway</module>
    <module>services/identity</module>
    <module>services/ledger</module>
    <module>services/catalog</module>
    <module>services/portfolio</module>
    <module>services/planning</module>
    <module>services/reco</module>
    <module>services/billing</module>
    <module>services/commerce</module>
    <module>services/audit</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-db</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-idempotency</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-cache</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>dexter-lab</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.dexter</groupId>
        <artifactId>portfolio-calc</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-baseline</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[${java.version},)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.6,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <message>JPA/Hibernate ORM is banned in Dexter v2 (MASTER_PLAN 1, 3.10). Use JdbcClient.</message>
                  <excludes>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.springframework.data:spring-data-jpa</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-data-jpa</exclude>
                    <exclude>org.springframework.boot:spring-boot-data-jpa</exclude>
                    <exclude>org.springframework.boot:spring-boot-hibernate</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-convergence</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <fail>${dexter.enforce.convergence}</fail>
              <rules><dependencyConvergence/></rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Coverage is reported, not gated (MASTER_PLAN 10). Report: target/site/jacoco. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>prepare-agent-it</id>
            <goals><goal>prepare-agent-integration</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes><include>**/*Test.java</include></includes>
          <excludes><exclude>**/*IT.java</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes><include>**/*IT.java</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
